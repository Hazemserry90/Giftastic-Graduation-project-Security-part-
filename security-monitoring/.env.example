# Giftastic security monitoring lab - Wazuh stack secrets.
#
# Copy this file to `.env` in the same directory before starting the stack:
#   cp .env.example .env
#
# The defaults below match the Wazuh demo certificate/user bundle that the
# generated certs and internal_users.yml were produced for, so the stack boots
# out of the box. THIS IS A LAB DEFAULT: change every value for anything
# reachable from an untrusted network.
#
# Changing INDEXER_PASSWORD or DASHBOARD_PASSWORD also requires regenerating the
# matching bcrypt hashes in config/wazuh_indexer/internal_users.yml.

# Wazuh indexer / dashboard bootstrap admin
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword

# Internal dashboard->indexer service account
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver

# Wazuh manager API account
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# Directory (relative to this compose file) that receives Giftastic and Cowrie
# logs for the manager to ingest.
LAB_LOG_DIR=./logs

# Host path where the Giftastic backend writes its security audit log. The
# backend default is `logs/security-audit.log` relative to the backend working
# directory. Override if you point SECURITY_AUDIT_LOG_FILE elsewhere.
GIFTASTIC_AUDIT_LOG=./logs/giftastic/security-audit.log
