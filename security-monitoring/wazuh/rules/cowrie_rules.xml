<!--
  Cowrie honeypot rules for Wazuh.

  Cowrie writes one JSON object per event to var/log/cowrie/cowrie.json and the
  file is ingested with <log_format>json</log_format>. The built-in `json`
  decoder exposes every key as a dynamic field, so these rules match on
  `eventid`, `src_ip`, `username`, `password`, and `input`.

  Typical Cowrie event ids:
    cowrie.session.connect
    cowrie.login.failed
    cowrie.login.success
    cowrie.command.input
    cowrie.session.file_download
    cowrie.session.closed
-->
<group name="cowrie,honeypot,">

  <rule id="100300" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie\.</field>
    <description>Cowrie honeypot event</description>
    <options>no_full_log</options>
  </rule>

  <!-- ============================ Session activity ========================= -->

  <rule id="100301" level="3">
    <if_sid>100300</if_sid>
    <field name="eventid">^cowrie\.session\.connect$</field>
    <description>Cowrie: SSH/Telnet connection from $(src_ip):$(src_port) to the honeypot</description>
    <group>cowrie_connect,recon,</group>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

  <rule id="100302" level="3">
    <if_sid>100300</if_sid>
    <field name="eventid">^cowrie\.session\.closed$</field>
    <description>Cowrie: session $(session) closed</description>
    <group>cowrie_session,</group>
  </rule>

  <!-- ============================ Authentication =========================== -->

  <rule id="100310" level="6">
    <if_sid>100300</if_sid>
    <field name="eventid">^cowrie\.login\.failed$</field>
    <description>Cowrie: failed login $(username)/$(password) from $(src_ip)</description>
    <group>cowrie_auth,authentication_failed,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100311" level="9">
    <if_sid>100300</if_sid>
    <field name="eventid">^cowrie\.login\.success$</field>
    <description>Cowrie: attacker gained access with $(username)/$(password) from $(src_ip)</description>
    <group>cowrie_auth,authentication_success,</group>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100312" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100310</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie: brute-force from $(src_ip) - multiple failed honeypot logins</description>
    <group>cowrie_auth,authentication_failures,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- Credential reuse against the honeypot can reveal password-spraying origins. -->
  <rule id="100313" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100310</if_matched_sid>
    <same_field>username</same_field>
    <different_field>src_ip</different_field>
    <description>Cowrie: same credential '$(username)' tried from multiple source IPs - password spraying</description>
    <group>cowrie_auth,authentication_failures,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- ========================== Post-exploitation ========================== -->

  <rule id="100320" level="8">
    <if_sid>100300</if_sid>
    <field name="eventid">^cowrie\.command\.input$</field>
    <description>Cowrie: attacker command from $(src_ip): $(input)</description>
    <group>cowrie_command,</group>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100321" level="12">
    <if_sid>100320</if_sid>
    <match type="pcre2">(wget|curl|tftp|ftp|scp|nc|ncat|socat)\s</match>
    <description>Cowrie: attacker downloading a payload or opening a channel from $(src_ip): $(input)</description>
    <group>cowrie_command,tool_transfer,</group>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <rule id="100322" level="10">
    <if_sid>100320</if_sid>
    <match type="pcre2">(chmod|chattr|chown|setenforce)\s</match>
    <description>Cowrie: attacker changing permissions/attributes from $(src_ip): $(input)</description>
    <group>cowrie_command,defense_evasion,</group>
    <mitre>
      <id>T1222</id>
    </mitre>
  </rule>

  <rule id="100323" level="12">
    <if_sid>100320</if_sid>
    <match type="pcre2">(crontab|systemctl|service\s|rc\.local|/etc/passwd|authorized_keys)</match>
    <description>Cowrie: attacker attempting persistence from $(src_ip): $(input)</description>
    <group>cowrie_command,persistence,</group>
    <mitre>
      <id>T1053</id>
    </mitre>
  </rule>

  <rule id="100324" level="12">
    <if_sid>100320</if_sid>
    <match type="pcre2">(cat\s+/etc/shadow|cat\s+/etc/passwd|sudoers|history|\.ssh/)</match>
    <description>Cowrie: attacker performing credential/secret discovery from $(src_ip): $(input)</description>
    <group>cowrie_command,credential_access,</group>
    <mitre>
      <id>T1552</id>
    </mitre>
  </rule>

  <rule id="100330" level="12">
    <if_sid>100300</if_sid>
    <field name="eventid">^cowrie\.session\.file_download$</field>
    <description>Cowrie: file transfer from $(src_ip) - $(url)</description>
    <group>cowrie_command,tool_transfer,</group>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

</group>
