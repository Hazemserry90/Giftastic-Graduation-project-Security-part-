        datetime updatedAt
        datetime publishedAt
        string reviewRequestStatus
        decimal averageRating
        int reviewCount
        int stockQuantity
        decimal discountPercentage
        datetime discountStartDate
        datetime discountEndDate
    }

    PRODUCT_DETAILS {
        UUID productId FK
        boolean allowsEngraving
        boolean allowsCustomMessage
        boolean allowsGiftWrap
        boolean requiresDeliveryDate
        int minDeliveryDays
        int maxDeliveryDays
        string tags
        string gender
        string occasion
        string recipientType
        string vendorSku
        boolean handmade
        boolean madeToOrder
        boolean customizable
    }

    PRODUCT_IMAGE {
        UUID productId FK
        UUID id
        string url
        boolean primary
        int displayOrder
    }

    CATEGORY {
        UUID id PK
        UUID categoryId
        string categoryName
        string name
    }

    PRODUCT_CATEGORY {
        UUID productId FK
        UUID categoryId FK
    }

    CART {
        UUID id PK
        UUID customerId FK
        datetime updatedAt
    }

    CART_ITEM {
        UUID cartId FK
        UUID productId FK
        int quantity
        string groupId
        string metadata
    }

    ORDER {
        UUID id PK
        UUID customerId FK
        string status
        decimal totalAmount
