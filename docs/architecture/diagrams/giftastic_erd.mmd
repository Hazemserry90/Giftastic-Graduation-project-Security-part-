erDiagram
    USER {
        UUID id PK
        string email UK
        string passwordHash
        boolean isBanned
        boolean requestedAdmin
        string fullName
        string phoneNumber
        string instapayRefundPhoneNumber
        string instapayRefundName
        date birthday
    }

    ADDRESS {
        string label
        string street
        string city
        string state
        string zipCode
        string country
        boolean isDefault
    }

    ADMIN {
        UUID userId PK
    }

    ADMIN_PERMISSION {
        UUID userId FK
        string permission
    }

    ADMIN_REQUEST {
        UUID id PK
        UUID userId FK
        string message
        string status
        datetime requestedAt
        datetime reviewedAt
        UUID reviewedBy FK
        string reviewNotes
        datetime canReapplyAt
    }

    VENDOR {
        UUID userId PK
        UUID supplierId UK
        string storeName
        string description
        string logoUrl
        string bannerUrl
        string contactEmail
        string contactPhone
        string address
        string websiteUrl
        string instagramUrl
        string facebookUrl
        string workingHours
        boolean isVerified
    }

    VENDOR_APPLICATION {
        UUID id PK
        UUID userId FK
        string storeName
        string description
        string logoUrl
        string bannerUrl
        string contactEmail
        string contactPhone
        string address
        string websiteUrl
        string instagramUrl
        string facebookUrl
        string workingHours
        string status
        datetime submittedAt
        datetime reviewedAt
        UUID reviewedBy FK
        string rejectionReason
    }

    VENDOR_ACTIVITY {
        UUID id PK
        UUID vendorId FK
        string activityType
        string description
        UUID relatedEntityId
        string metadata
        datetime occurredAt
    }

    PRODUCT {
        UUID id PK
        UUID supplierId FK
        string name
        string description
        decimal price
        string pricingMode
        string status
