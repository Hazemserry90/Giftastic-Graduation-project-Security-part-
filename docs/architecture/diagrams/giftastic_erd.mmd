        UUID deliveryZoneId FK
        decimal deliveryCost
        datetime estimatedDeliveryDate
        datetime actualDeliveryDate
        boolean commissionPaid
    }

    GUEST_INFO {
        UUID orderId FK
        string firstName
        string lastName
        string email
        string phone
        string shippingAddress
    }

    ORDER_ITEM {
        UUID orderId FK
        UUID productId FK
        string productName
        string imageUrl
        int quantity
        decimal price
        UUID supplierId FK
        string groupId
        string metadata
    }

    DELIVERY_ZONE {
        UUID id PK
        string zoneName UK
        string description
        boolean isActive
    }

    VENDOR_DELIVERY_PRICING {
        UUID vendorId PK,FK
        UUID zoneId PK,FK
        decimal deliveryCost
        datetime updatedAt
    }

    GIFT_FLOW {
        UUID id PK
        UUID supplierId FK
        string name
        string description
        string configuration
        string imageUrl
        datetime createdAt
        datetime updatedAt
    }

    FAVORITE {
        UUID id PK
        UUID userId FK
        UUID productId FK
        UUID flowId FK
        datetime addedAt
    }

    REVIEW {
        UUID id PK
        UUID userId FK
        string reviewType
        UUID entityId
        decimal rating
        string comment
        string status
        datetime createdAt
        datetime reviewedAt
        UUID reviewedBy FK
        boolean isAnonymous
        double contentScore
        UUID orderId FK
    }

    VENDOR_FEEDBACK {
        UUID id PK
        UUID userId FK
        UUID vendorId FK
        int rating
        string comment
        string status
        datetime createdAt
        datetime reviewedAt
        UUID reviewedBy FK
    }

    USER_REVIEW_RESTRICTION {
        UUID userId PK,FK
        boolean canComment
        boolean canReview
        string reason
        datetime restrictedAt
        datetime expiresAt
        UUID restrictedBy FK
    }

    REPORT {
        UUID id PK
        UUID reporterId FK
        string reportType
        UUID reportedEntityId
        string reason
        string description
        string status
        datetime createdAt
        datetime reviewedAt
        UUID reviewedBy FK
        string adminNotes
    }

    NOTIFICATION {
        UUID id PK
        UUID userId FK
        string title
        string message
        string type
        boolean read
        datetime createdAt
        string metadata
    }

    REMINDER {
        UUID id PK
        UUID customerId FK
        string description
        datetime scheduledAt
        boolean processed
    }

    COMMISSION {
        UUID id PK
        UUID orderId FK
        UUID supplierId FK
        decimal orderSubtotal
        decimal commissionRate
        decimal commissionAmount
        string direction
        string status
        datetime dueDate
        datetime paidAt
        datetime createdAt
    }

    COMMISSION_PAYMENT_REQUEST {
        UUID id PK
        UUID commissionId FK
        UUID supplierId FK
        string message
        string proofImageUrl
        string status
        datetime submittedAt
        datetime reviewedAt
        UUID reviewedBy FK
        string rejectionReason
    }

    COMMISSION_RULE {
        UUID id PK
        string type
        UUID supplierId FK
        decimal rate
        datetime startDate
        datetime endDate
        boolean active
        UUID createdBy FK
        datetime createdAt
    }

    ORDER_ASSISTANCE_REQUEST {
        UUID id PK
        UUID orderId FK
        UUID supplierId FK
        string message
        string status
        datetime requestedAt
        datetime resolvedAt
        UUID resolvedBy FK
        string resolution
    }

    ORDER_ASSISTANCE_MESSAGE {
        UUID id PK
        UUID requestId FK
        UUID senderId FK
        string senderRole
        string message
        datetime createdAt
    }

